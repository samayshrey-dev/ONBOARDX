# ONBOARDX Django Backend Environment Settings
# Copy to .env for production deployment

SECRET_KEY=django-insecure-onboardx-production-secret-key-change-me
DEBUG=False
ALLOWED_HOSTS=onboardx-backend.onrender.com,localhost,127.0.0.1
SECURE_SSL_REDIRECT=True

# Database Configuration (Managed PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=onboardx_db
DB_USER=onboardx_user
DB_PASSWORD=secure_postgres_password_here
DB_HOST=dpg-xxxxxxxx-a.render.com
DB_PORT=5432

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://onboardx.onrender.com,http://localhost:5173
